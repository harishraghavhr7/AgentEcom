# ==============================================================================
# AgentEcom Environment Configuration
# ==============================================================================

# LLM Providers Configuration
# Paste your Groq API Key below (get it free from https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Default LLM Provider ('groq' or 'local')
# When set to 'local' or if GROQ_API_KEY is empty, the zero-key deterministic fallback planner is used.
DEFAULT_LLM_PROVIDER=groq

# Database
DATABASE_URL=sqlite+aiosqlite:///./agentecom.db

# ==============================================================================
# LangSmith Observability & Tracing Configuration
# ==============================================================================
# Set LANGSMITH_TRACING=true and paste your LANGSMITH_API_KEY from https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AgentEcom

# LangChain Tracing V2 (Automatic fallback)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AgentEcom
