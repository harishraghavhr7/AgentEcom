# ==============================================================================
# AgentEcom Environment Configuration
# ==============================================================================

# Database
DATABASE_URL=sqlite+aiosqlite:///./agentecom.db

# LLM Providers (Groq or Ollama)
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# LangSmith Observability & Tracing Configuration
# ==============================================================================
# Set LANGSMITH_TRACING=true and fill your LANGSMITH_API_KEY to enable full tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AgentEcom

# LangChain Tracing V2 (Automatic fallback)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AgentEcom
