# ==============================================================================
# AgentEcom Environment Configuration
# ==============================================================================

# LLM Providers Configuration & Resilient Fallback Cascade
# Order of fallback: groq -> gemini -> openrouter
FALLBACK_CASCADE_ORDER=groq,gemini,openrouter

# 1. Groq API (Primary LLM)
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# 2. Google Gemini API (First Fallback)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# 3. OpenRouter API (Second Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default LLM Provider ('groq', 'gemini', 'openrouter', 'ollama', or 'local')
# When set to 'local' or if all cloud APIs fail/have no keys, the zero-key deterministic fallback planner is used.
DEFAULT_LLM_PROVIDER=groq

# Database
DATABASE_URL=sqlite+aiosqlite:///./agentecom.db

# ==============================================================================
# LangSmith Observability & Tracing Configuration
# ==============================================================================
# Set LANGSMITH_TRACING=true and paste your LANGSMITH_API_KEY from https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AgentEcom

# LangChain Tracing V2 (Automatic fallback)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AgentEcom
