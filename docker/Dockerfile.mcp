# ==============================================================================
# AgentEcom — Dedicated FastMCP Server Microservice
# Exposes Model Context Protocol (v2024-11-05) via SSE and JSON-RPC
# ==============================================================================
FROM python:3.11-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DATABASE_URL=sqlite+aiosqlite:////app/data/agentecom.db \
    MCP_PORT=8001

WORKDIR /app

# Install system dependencies (curl for container healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source code
COPY agentecom/ /app/agentecom/

# Create persistent data directory for SQLite & embeddings
RUN mkdir -p /app/data

EXPOSE 8001

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD sh -c "curl -f http://localhost:${PORT:-8001}/health || exit 1"

CMD ["sh", "-c", "uvicorn agentecom.mcp.service:app --host 0.0.0.0 --port ${PORT:-8001}"]
